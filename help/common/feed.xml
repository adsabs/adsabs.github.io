---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

  <title>NASA/SAO Astrophysics Data System</title>
  <link href="{{ site.ads_base_url }}/"/>
  <link type="application/atom+xml" rel="self" href="{{ site.ads_base_url }}{{ site.baseurl }}/help/common/feed.xml"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.ads_base_url }}/</id>
  <author>
    <name>ADS Team</name>
    <email>adshelp@cfa.harvard.edu</email>
  </author>
  <rights>Copyright © {{ site.time | date: "%Y" }}, NASA/SAO Astrophysics Data System</rights>

  {% assign ads_posts = site.posts | where_exp: "post", "post.category == 'blog'" %}
  {% for post in ads_posts limit:10 %}
      <entry>
        <id>{{ site.ads_base_url }}{{ post.id }}</id>
        <link type="text/html" rel="alternate" href="{{ site.ads_base_url }}{{ post.url }}"/>
        <title>{{ post.title | xml_escape }}</title>
        <published>{{ post.date | date_to_xmlschema }}</published>
        <updated>{{ post.date | date_to_xmlschema }}</updated>
        <author>
          <name>{{ post.author | xml_escape }}</name>
        </author>
        <content type="html">{{ post.content | xml_escape }}</content>
      </entry>
  {% endfor %}

</feed>
